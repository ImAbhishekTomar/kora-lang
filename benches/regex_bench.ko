# The re module: compile cache, find_all, replace, split. Patterns often come
# from config or a model, so this path runs on every request in real programs.

use re

def main():
    line = "user 42 ada@example.com ok\n"
    text = line * 8000

    found = 0
    i = 0
    while i < 100:
        match re.find_all("[a-z]+@[a-z.]+", text):
            case Ok(hits):
                found += len(hits)
            case Err(why):
                print(why)
        i += 1

    match re.replace("[0-9]+", text, "N"):
        case Ok(masked):
            print(f"re: {found} {len(masked)}")
        case Err(why):
            print(why)
