# Phase 4: classified data and scoped declassification.
#
# `salary` is classified, so it cannot reach a model at all unless a
# `declassify ... for <sink>:` block releases it to a sink the project
# policy allows. Policy lives in kora.toml: local_model accepts classified
# data, openai does not.

type Employee:
    name: str
    role: str
    classified salary: int

type Assessment:
    band: str
    rationale: str

def market_rate(role: str) -> int:
    if role == "staff engineer":
        return 210
    if role == "senior engineer":
        return 175
    return 140

agent review(emp: Employee) -> str:
    budget: max_tokens = 4000

    # Salary may reach the on-box model, never a vendor API.
    declassify emp.salary as pay for local_model:
        a: Assessment = analyze(
            {"role": emp.role, "pay": pay, "market": market_rate(emp.role)},
            "assess whether pay is below, at, or above market; band must be one of below/at/above"
        )

    match a:
        case Ok(assessment):
            return f"{emp.name}: {assessment.band} — {assessment.rationale}"
        case Uncertain(reason):
            return f"{emp.name}: needs a human ({reason})"
        case Exhausted(meter):
            return f"{emp.name}: budget out of {meter}"
        case Failed(why):
            return f"{emp.name}: provider did not answer: {why}"

def main():
    team = [
        Employee("Ada", "staff engineer", 165),
        Employee("Grace", "senior engineer", 180),
    ]

    with budget(max_tokens = 20000):
        results = parallel for emp in team:
            return review(emp)

        for line in results:
            print(line)
