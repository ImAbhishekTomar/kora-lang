# Phase 3: agents, tools, parallel fan-out, and token budgets.
#
# Every ticket is triaged by its own agent on its own thread, all drawing
# from one shared token budget. Exhaustion is a value, so partial work
# survives instead of the whole run failing.

type Ticket:
    severity: str
    product: str
    summary: str

tool priority_for(severity: str) -> int:
    "Map a severity label to the on-call priority number."
    if severity == "high":
        return 1
    if severity == "medium":
        return 2
    return 3

agent triage(raw: str) -> str:
    budget: max_tokens = 4000, max_steps = 4

    t: Ticket = analyze(raw, "classify this support ticket into severity (low/medium/high), product, and a one-line summary")
    match t:
        case Ok(ticket):
            return f"P{priority_for(ticket.severity)}  [{ticket.product}] {ticket.summary}"
        case Uncertain(reason):
            return f"??  needs a human: {reason}"
        case Exhausted(meter):
            return f"--  budget out of {meter}"
        case Failed(why):
            return f"!!  provider did not answer: {why}"

def main():
    tickets = [
        "the checkout page returns a 500 for every card payment, nobody can buy anything",
        "could you add a dark mode to the dashboard someday?",
        "CSV export drops the last row when there are more than 1000 records",
    ]

    with budget(max_tokens = 20000):
        results = parallel for t in tickets:
            return triage(t)

        for line in results:
            print(line)

        print(f"\nspent {tokens_spent()} tokens across {calls_spent()} calls")
