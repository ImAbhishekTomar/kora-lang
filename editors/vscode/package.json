{
  "name": "kora-lang",
  "displayName": "Kora Language",
  "description": "Syntax highlighting, IntelliSense, and debugging for the Kora programming language (.ko)",
  "version": "0.2.0",
  "publisher": "kora-lang",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/abhishektomar/kora-lang"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "kora",
    "agent",
    "language server",
    "syntax highlighting",
    "modules",
    "packages",
    "debugger",
    "vision",
    "multimodal"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onLanguage:kora",
    "onDebugResolve:kora",
    "onDebugDynamicConfigurations:kora"
  ],
  "contributes": {
    "languages": [
      {
        "id": "kora",
        "aliases": [
          "Kora",
          "kora"
        ],
        "extensions": [
          ".ko"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/file-icon.svg",
          "dark": "./images/file-icon.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "kora",
        "scopeName": "source.kora",
        "path": "./syntaxes/kora.tmLanguage.json"
      }
    ],
    "iconThemes": [
      {
        "id": "kora-icons",
        "label": "Kora Icons",
        "path": "./fileicons/kora-icon-theme.json"
      }
    ],
    "themes": [
      {
        "label": "Kora Light",
        "uiTheme": "vs",
        "path": "./themes/kora-light-color-theme.json"
      },
      {
        "label": "Kora Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/kora-dark-color-theme.json"
      }
    ],
    "commands": [
      {
        "command": "kora.runFile",
        "title": "Kora: Run Current File",
        "icon": "$(play)"
      },
      {
        "command": "kora.testFile",
        "title": "Kora: Test Current File",
        "icon": "$(beaker)"
      },
      {
        "command": "kora.debugFile",
        "title": "Kora: Debug Current File",
        "icon": "$(debug-alt)"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "kora.runFile",
          "when": "resourceLangId == kora",
          "group": "navigation"
        },
        {
          "command": "kora.testFile",
          "when": "resourceLangId == kora",
          "group": "navigation"
        },
        {
          "command": "kora.debugFile",
          "when": "resourceLangId == kora",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "kora.runFile",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r",
        "when": "resourceLangId == kora && editorTextFocus"
      }
    ],
    "configuration": {
      "title": "Kora",
      "properties": {
        "kora.serverPath": {
          "type": "string",
          "default": "kora",
          "description": "Path to the kora binary used for the language server and the debug adapter."
        }
      }
    },
    "breakpoints": [
      {
        "language": "kora"
      }
    ],
    "debuggers": [
      {
        "type": "kora",
        "label": "Kora",
        "languages": [
          "kora"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "Absolute path to the .ko file to debug.",
                "default": "${file}"
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Stop before the first statement runs.",
                "default": false
              },
              "replay": {
                "type": "boolean",
                "description": "Serve model calls from the cassette instead of a provider, so a debug session costs nothing.",
                "default": false
              },
              "record": {
                "type": "boolean",
                "description": "Call models for real and save the calls to the cassette.",
                "default": false
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "kora",
            "request": "launch",
            "name": "Debug current Kora file",
            "program": "${file}",
            "stopOnEntry": false
          }
        ],
        "configurationSnippets": [
          {
            "label": "Kora: debug the current file",
            "description": "Run the open .ko file under the debugger",
            "body": {
              "type": "kora",
              "request": "launch",
              "name": "Debug current Kora file",
              "program": "^\"\\${file}\"",
              "stopOnEntry": false
            }
          },
          {
            "label": "Kora: debug with recorded model calls",
            "description": "Replay model calls from the cassette, so the session is free and deterministic",
            "body": {
              "type": "kora",
              "request": "launch",
              "name": "Debug (replay)",
              "program": "^\"\\${file}\"",
              "replay": true
            }
          }
        ]
      }
    ]
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
